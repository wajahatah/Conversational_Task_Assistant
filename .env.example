# ══════════════════════════════════════════════════════════════════════════════
#  Conversational Task Assistant — Environment Configuration
#  Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-string

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_assistant

# Assembled automatically from the above — override only if needed
# DATABASE_URL=postgresql+asyncpg://task_user:task_password@localhost:5432/task_assistant

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Set only ONE of TELEGRAM_BOT_TOKEN or DISCORD_BOT_TOKEN — not both.
# Telegram takes priority if both are set.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Leave TELEGRAM_WEBHOOK_URL empty for long-polling mode (local dev)
# Set it to your public HTTPS URL for webhook mode (production)
TELEGRAM_WEBHOOK_URL=

# ─── Discord ──────────────────────────────────────────────────────────────────
# Leave TELEGRAM_BOT_TOKEN empty (or remove it) to activate the Discord bot.
# Steps to create a Discord bot:
#   1. discord.com/developers → New Application → Bot → Add Bot
#   2. Bot tab → Reset Token → copy the token below
#   3. Bot tab → Privileged Gateway Intents → enable MESSAGE CONTENT INTENT
#   4. OAuth2 → URL Generator → scope: bot → permissions: Send Messages, Read Message History
#   5. Open the generated URL to invite the bot to your server
#   6. DM the bot and type /start
DISCORD_BOT_TOKEN=

# ─── LLM Provider Selection ───────────────────────────────────────────────────
# Choose ONE: openai | gemini | anthropic | ollama | huggingface
LLM_PROVIDER=openai

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o                  # gpt-4o | gpt-4-turbo | gpt-3.5-turbo
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro          # gemini-1.5-pro | gemini-1.5-flash

# ─── Anthropic Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Ollama (Local) ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2                # any model pulled via `ollama pull`

# ─── HuggingFace (Local Inference) ────────────────────────────────────────────
HF_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
HF_DEVICE=cpu                        # cpu | cuda | mps

# ─── Scheduler Settings ───────────────────────────────────────────────────────
TASK_EVALUATION_INTERVAL_MINUTES=5   # How often to check task states
DEFAULT_SUMMARY_TIME=08:00           # Default daily summary time (HH:MM, 24h)

# ─── Task Business Rules ──────────────────────────────────────────────────────
MAX_EXTENSIONS=2                     # Max times a task can be extended
MAX_IGNORED_PROMPTS=3                # Ignored prompts before task → STALLED
NUDGE_COOLDOWN_MINUTES=30            # Min minutes between nudges for same task

# AT_RISK thresholds (percentage of task time remaining)
AT_RISK_THRESHOLD_1=35               # First nudge when ≤35% time remains
AT_RISK_THRESHOLD_2=10               # Second nudge when ≤10% time remains
